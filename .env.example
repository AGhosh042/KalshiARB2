# Copy to .env and fill in real values. Never commit .env.

# --- Required for the bot ---
# Kalshi binary market ticker (e.g. BTC 15-minute contract). Must match an open market.
KALSHI_MARKET_TICKER=

# --- Kalshi API (RSA signing) ---
KALSHI_API_KEY_ID=
# Full PEM private key, or base64 body only (see README). Use \n for newlines in a single line if needed.
KALSHI_PRIVATE_KEY_PEM=
# API host must match where the key was created (default = production).
# Production: https://api.elections.kalshi.com/trade-api/v2
# Demo:       https://demo-api.kalshi.co/trade-api/v2
# KALSHI_BASE_URL=

# --- Coinbase Advanced Trade (optional for public WS; set if you extend auth) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Safety: default true = simulate orders, no real trades ---
DRY_RUN=true

# Paper balance for dry-run/demo accounting (cents). Default 100000 = $1000.
PAPER_BALANCE_CENTS=100000

# --- Strategy tuning (optional) ---
PRICE_MOVE_THRESHOLD_PCT=0.05
KALSHI_EDGE_THRESHOLD=3
KALSHI_REFERENCE_PRICE_DOLLARS=71052.06
DEMO_KALSHI_UNDERLYING_DOLLARS=
MAX_POSITION_SIZE=50
MAX_OPEN_ORDERS=2
POLL_INTERVAL_MS=500
TREND_WINDOW_SECONDS=30
# Live: seconds to wait on exit limit before canceling and flattening with market sells (default 5000 ms).
EXIT_LIMIT_GRACE_MS=5000
# Max time in pending exit before giving up (cancel + HOLD). Should exceed EXIT_LIMIT_GRACE_MS.
EXIT_WAIT_TIMEOUT_MS=120000
# EMA weight when API does not expose BTC-scale index (0.05 ≈ lagged vs Coinbase)
SYNTHETIC_UNDERLYING_ALPHA=0.05

# --- Runtime ---
LOG_LEVEL=info
DASHBOARD_PORT=3000
